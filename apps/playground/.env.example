# Google Analytics id. Compiled into the bundle at build time — the playground is
# a static site, so there is no server left to read this at runtime. Leave it
# unset and gtag stays disabled.
NUXT_PUBLIC_GTAG_ID=G-XXX

# Host ports published by docker-compose (containers always listen on 80).
PLAYGROUND_PORT=3010
PLAYGROUND_LOCAL_PORT=3011
