{
  "name": "@hydra-sdk/evaluator",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Hydra SDK - Offline transaction-level Plutus evaluator (exUnits without a provider)",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "homepage": "https://hydrasdk.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vtechcom/hydra-sdk.git",
    "directory": "packages/evaluator"
  },
  "keywords": [
    "@hydra-sdk/evaluator",
    "hydra-evaluator",
    "plutus-evaluator",
    "exunits",
    "uplc",
    "hydra",
    "cardano",
    "cardano-wasm",
    "offline-evaluator"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --watch --dts",
    "test": "vitest --run",
    "test:u": "vitest -u --run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "update:snapshot": "vitest -u"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "whisky-evaluator": "0.1.1"
  },
  "peerDependenciesMeta": {
    "whisky-evaluator": {
      "optional": true
    }
  },
  "devDependencies": {
    "scalus": "0.17.0",
    "tsup": "^6.7.0",
    "vite": "^7.0.5",
    "whisky-evaluator": "0.1.1"
  },
  "dependencies": {
    "@hydra-sdk/cardano-wasm": "workspace:*",
    "@hydra-sdk/core": "workspace:*"
  }
}
