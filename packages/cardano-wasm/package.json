{
	"name": "@hydra-sdk/cardano-wasm",
	"license": "Apache-2.0",
	"version": "0.0.6",
	"publishConfig": {
		"access": "public"
	},
	"description": "Cardano-WASM library for Hydra Wallet",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"module": "dist/index.mjs",
	"files": [
		"dist"
	],
	"homepage": "https://hydrasdk.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/Vtechcom/hydra-sdk.git",
		"directory": "packages/hydra-wallet"
	},
	"keywords": [
		"hydra",
		"wallet",
		"hydrawallet",
		"hydra-wallet",
		"hydra-wallet-sdk",
		"hydra wallet sdk",
		"hydra wallet",
		"cardano-wasm",
		"cardano wasm",
		"cardano-wallet-sdk",
		"cardano wallet sdk",
		"cardano",
		"cardano-wallet",
		"chain"
	],
	"exports": {
		".": {
			"browser": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.mjs",
				"require": "./dist/index.js"
			},
			"node": {
				"types": "./dist/index.node.d.ts",
				"import": "./dist/index.node.mjs",
				"require": "./dist/index.node.js"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.mjs",
				"require": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch --dts",
		"test": "vitest --run",
		"test:u": "vitest -u --run",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
		"update:snapshot": "vitest -u"
	},
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"tsup": "^6.7.0",
		"vite": "^7.0.5"
	},
	"dependencies": {
		"@emurgo/cardano-serialization-lib-asmjs": "14.1.2",
		"@emurgo/cardano-serialization-lib-browser": "14.1.2",
		"@emurgo/cardano-serialization-lib-nodejs": "14.1.2"
	}
}
