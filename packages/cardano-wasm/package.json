{
	"name": "@hydra-sdk/cardano-wasm",
	"license": "Apache-2.0",
	"version": "1.0.0",
	"publishConfig": {
		"access": "public"
	},
	"description": "Cardano-WASM library for Hydra Wallet",
	"type": "commonjs",
	"sideEffects": false,
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"module": "dist/index.mjs",
	"typesVersions": {
		"*": {
			"asmjs": [
				"./dist/index.asmjs.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"homepage": "https://hydrasdk.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vtechcom/hydra-sdk.git",
		"directory": "packages/cardano-wasm"
	},
	"keywords": [
		"hydra",
		"wallet",
		"hydrawallet",
		"hydra-wallet",
		"hydra-wallet-sdk",
		"hydra wallet sdk",
		"hydra wallet",
		"cardano-wasm",
		"cardano wasm",
		"cardano-wallet-sdk",
		"cardano wallet sdk",
		"cardano",
		"cardano-wallet",
		"chain"
	],
	"exports": {
		".": {
			"browser": {
				"import": {
					"types": "./dist/index.d.mts",
					"default": "./dist/index.mjs"
				},
				"require": {
					"types": "./dist/index.d.ts",
					"default": "./dist/index.js"
				}
			},
			"node": {
				"import": {
					"types": "./dist/index.node.d.mts",
					"default": "./dist/index.node.mjs"
				},
				"require": {
					"types": "./dist/index.node.d.ts",
					"default": "./dist/index.node.js"
				}
			},
			"default": {
				"import": {
					"types": "./dist/index.d.mts",
					"default": "./dist/index.mjs"
				},
				"require": {
					"types": "./dist/index.d.ts",
					"default": "./dist/index.js"
				}
			}
		},
		"./asmjs": {
			"import": {
				"types": "./dist/index.asmjs.d.mts",
				"default": "./dist/index.asmjs.mjs"
			},
			"require": {
				"types": "./dist/index.asmjs.d.ts",
				"default": "./dist/index.asmjs.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup && node scripts/postbuild-dts.mjs",
		"dev": "tsup --watch --dts",
		"test": "vitest --run",
		"test:u": "vitest -u --run",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
		"update:snapshot": "vitest -u"
	},
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"tsup": "^6.7.0",
		"vite": "^7.0.5"
	},
	"dependencies": {
		"@emurgo/cardano-serialization-lib-asmjs": "14.1.2",
		"@emurgo/cardano-serialization-lib-browser": "14.1.2",
		"@emurgo/cardano-serialization-lib-nodejs": "14.1.2"
	}
}
