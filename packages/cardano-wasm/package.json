{
  "name": "@hydrawallet/cardano-wasm",
  "license": "MIT",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Cardano-WASM library for Hydra Wallet",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aniadev/hydra-wallet-sdk.git",
    "directory": "packages/hydra-wallet"
  },
  "keywords": [
    "hydra",
    "wallet",
    "hydrawallet",
    "hydra-wallet",
    "hydra-wallet-sdk",
    "cardano",
    "cardano-wallet",
    "chain"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --run",
    "test:u": "vitest -u --run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "update:snapshot": "vitest -u"
  },
  "engines": {
    "node": ">=10"
  },
  "devDependencies": {
    "tsup": "^6.7.0",
    "vite": "^7.0.5"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-browser": "14.1.2"
  }
}
