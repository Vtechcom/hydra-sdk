{
  "name": "@hydra-sdk/transaction",
  "license": "Apache-2.0",
  "version": "1.1.7",
  "publishConfig": {
    "access": "public"
  },
  "description": "Hydra SDK - Transaction library for building decentralized applications on Cardano",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "homepage": "https://hydrasdk.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vtechcom/hydra-sdk.git",
    "directory": "packages/hydrawallet-transaction"
  },
  "keywords": [
    "@hydra-sdk/transaction",
    "hydra-transaction",
    "hydra-transaction-builder",
    "hydra-tx-builder",
    "hydra-bridge",
    "hydra",
    "wallet",
    "hydrawallet",
    "hydra-wallet",
    "hydra-wallet-sdk",
    "hydra wallet sdk",
    "hydra wallet",
    "cardano-wasm",
    "cardano wasm",
    "cardano-wallet-sdk",
    "cardano wallet sdk",
    "cardano",
    "cardano-wallet",
    "chain"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --watch --dts",
    "test": "vitest --run",
    "test:u": "vitest -u --run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "update:snapshot": "vitest -u"
  },
  "engines": {
    "node": ">=10"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "tsup": "^6.7.0",
    "vite": "^7.0.5"
  },
  "dependencies": {
    "@hydra-sdk/cardano-wasm": "workspace:*",
    "@hydra-sdk/core": "workspace:*",
    "@scure/base": "^1.2.6",
    "bip39": "3.1.0",
    "json-bigint": "^1.0.0"
  }
}
